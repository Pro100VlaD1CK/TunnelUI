TUNNELUI_DATABASE_URL=sqlite:////var/lib/tunnelui/tunnelui.db
TUNNELUI_MASTER_KEY_FILE=/etc/tunnelui/master.key
TUNNELUI_ORIGIN=https://panel.example.invalid
TUNNELUI_SECURE_COOKIE=true
TUNNELUI_DEVELOPMENT=false
TUNNELUI_STATIC_DIR=/opt/tunnelui/frontend/dist
TUNNELUI_AGENT_SOCKET=/run/tunnelui/agent.sock
TUNNELUI_AGENT_MANAGED_ID=primary
TUNNELUI_AGENT_EXPECTED_VERSION=1.1.0
TUNNELUI_AGENT_PUBLIC_ADDRESS=vpn.example.invalid:443
